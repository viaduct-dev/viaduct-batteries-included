"""
A group that contains members and policies granting access to external services.
Groups serve dual purpose: app-internal access control and external service access.
Adding a user to a group grants them all the external service access that group's policies define.
"""
type Group implements Node @scope(to: ["default"]) {
  id: ID!
  name: String!
  description: String
  """Audit metadata only — carries no permission weight."""
  createdBy: String!
  status: GroupStatus!
  members: [GroupMember!]! @resolver
  """Cross-tenant view of all external service access this group has."""
  accessSummary: [PolicySummaryEntry!]! @resolver
  createdAt: String!
  updatedAt: String!
}

enum GroupStatus @scope(to: ["default"]) {
  ACTIVE
  DELETING
  ARCHIVED
}

"""
A unified cross-tenant summary of one policy entry for a group.
Returned by Group.accessSummary — spans GitHub, Asana, and any other tenant.
"""
type PolicySummaryEntry @scope(to: ["default"]) {
  assetType: String!
  assetName: String!
  externalId: String!
  permission: String!
  syncStatus: PolicySyncStatus!
}

enum PolicySyncStatus @scope(to: ["default", "github", "asana", "admin"]) {
  HEALTHY
  PENDING
  DEGRADED
  FAILED
}

type GroupMember @scope(to: ["default"]) {
  id: ID!
  groupId: String!
  personId: String!
  joinedAt: String!
}

input CreateGroupInput @scope(to: ["default"]) {
  name: String!
  description: String
}

input AddGroupMemberInput @scope(to: ["default"]) {
  groupId: ID! @idOf(type: "Group")
  personId: String!
}

input RemoveGroupMemberInput @scope(to: ["default"]) {
  groupId: ID! @idOf(type: "Group")
  personId: String!
}

input ArchiveGroupInput @scope(to: ["default"]) {
  groupId: ID! @idOf(type: "Group")
}

extend type Query @scope(to: ["default"]) {
  """Get all groups the current user is a member of."""
  groups: [Group!]! @resolver

  """Get a specific group by ID. Only accessible if the user is a member."""
  group(id: ID! @idOf(type: "Group")): Group @resolver
}

extend type Mutation @scope(to: ["default"]) {
  """Create a new group. The creator automatically becomes a member."""
  createGroup(input: CreateGroupInput!): Group! @resolver

  """Add a member to a group. Requires TenantAsset(default) EDITOR or higher."""
  addGroupMember(input: AddGroupMemberInput!): GroupMember! @resolver

  """Remove a member from a group. The member themselves or an EDITOR+ can remove."""
  removeGroupMember(input: RemoveGroupMemberInput!): Boolean! @resolver

  """
  Archive a group. Sets status to DELETING, enqueues RECONCILE_ASSET for all
  affected assets, then marks ARCHIVED. Requires TenantAsset(default) EDITOR.
  """
  archiveGroup(input: ArchiveGroupInput!): Group! @resolver
}
